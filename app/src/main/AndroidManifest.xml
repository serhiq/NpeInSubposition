<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="ru.evotor.permission.receipt.print.INTERNET_RECEIPT" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="ru.softc.permission.serviceprint.PRINT" />
    <uses-permission android:name="ru.softc.permission.receiptprinter.PRINT" />

    <uses-permission android:name="ru.evotor.permission.receipt.printExtra.SET" />
    <uses-permission android:name="ru.evotor.devices.SCANNER_RECEIVER" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Example"
        tools:targetApi="31">
        <meta-data
            android:name="app_uuid"
            android:value="35db77bc-5445-11ed-bdc3-0242ac120002" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <meta-data
                android:name="ru.evotor.launcher.BACKGROUND_COLOR"
                android:value="#E91E63" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.EVOTOR" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <receiver
            android:name=".receivers.EventsReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="evotor.intent.action.receipt.sell.RECEIPT_CLOSED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".services.ReceiptClosedService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".services.PaymentScreenService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_receipt"
            android:label="Чек">
            <meta-data
                android:name="ru.evotor.sales_screen.BACKGROUND_COLOR"
                android:value="#E91E63" />
            <intent-filter>
                <action android:name="evo.v2.receipt.sell.receiptDiscount" />
                <action android:name="evo.v2.receipt.correction.income.receiptDiscount" />
                <action android:name="evo.v2.receipt.correction.return.income.receiptDiscount" />
            </intent-filter>
        </service>

        <receiver
            android:name=".receivers.IncomeReceiptBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="evotor.intent.action.receipt.correction.income.OPENED" />
                <action android:name="evotor.intent.action.receipt.correction.income.RECEIPT_CLOSED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ShowReceiptActivity"
            android:exported="true">
            <meta-data
                android:name="ru.evotor.launcher.BACKGROUND_COLOR"
                android:value="#E91E63" />
        </activity>
    </application>
</manifest>